// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Modelo de Empresa (ex: Limpeza, TI, Segurança)
model Empresa {
  id        String        @id @default(uuid())
  nome      String        @unique
  pessoas   Colaborador[]

  @@map("tb_empresas")
}

// Cadastro Geral de Colaboradores e Prestadores
model Colaborador {
  id           String           @id @default(uuid())
  nomeCompleto String           @map("nome_completo")
  cpf          String           @unique
  fotoUrl      String?          @map("foto_url")
  empresaId    String           @map("id_empresa")
  empresa      Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  registros    RegistroAcesso[]

  @@map("tb_colaboradores")
}

// Histórico de Movimentação Diária e Auditoria
model RegistroAcesso {
  id                     String      @id @default(uuid())
  colaboradorId          String      @map("id_colaborador")
  colaborador            Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  
  // Dados de Entrada (Check-in)
  timestampEntrada       DateTime    @default(now()) @map("timestamp_entrada")
  operadorEntrada        String      @map("operador_entrada")
  descricaoServico       String      @map("descricao_servico") // Texto aberto obrigatório
  
  // Dados de Saída (Check-out)
  timestampSaida         DateTime?   @map("timestamp_saida")
  operadorSaida          String?     @map("operador_saida")
  servicosExtras         String?     @map("servicos_extras")   // Texto aberto opcional
  
  // Status de Controle Rápido
  status                 String      @default("DENTRO") // DENTRO ou FORA

  @@map("tb_registro_acesso")
}

// Modelo de Chave (Controle de Cautela CCO)
model Chave {
  id                String    @id @default(uuid())
  codigo            String    @unique
  status            String    @default("DISPONIVEL") // DISPONIVEL, EMPRESTADA, PERDIDA, QUEBRADA
  observacao        String?   @map("observacao")
  
  // Dados de Empréstimo Ativo
  emprestadaPara    String?   @map("emprestada_para")
  timestampRetirada DateTime? @map("timestamp_retirada")
  operadorLiberacao String?   @map("operador_liberacao")

  @@map("tb_chaves")
}

// Histórico de Movimentação de Chaves (Auditoria)
model RegistroChave {
  id          String   @id @default(uuid())
  chaveCodigo String   @map("chave_codigo")
  acao        String   // RETIRADA, DEVOLVIDA, PERDIDA, QUEBRADA, DISPONIBILIZADA
  responsavel String
  operador    String
  timestamp   DateTime @default(now()) @map("timestamp")
  observacao  String?  @map("observacao")

  @@map("tb_registro_chaves")
}

// Equipamentos de CFTV / Segurança Eletrônica
model EquipamentoCftv {
  id        String   @id @default(uuid())
  nome      String   @unique
  tipo      String   // LPR, RECONHECIMENTO_FACIAL, ALARME_MOVIMENTO, CAMERA_AUDIO, BODY_CAM, CFTV_PADRAO
  status    String   @default("DISPONIVEL") // DISPONIVEL (Funcionando), MANUTENCAO
  createdAt DateTime @default(now()) @map("created_at")

  @@map("tb_equipamentos_cftv")
}

// Defeitos abertos em equipamentos de CFTV
model DefeitoCftv {
  id              String   @id @default(uuid())
  equipamentoNome String   @map("equipamento_nome")
  descricao       String   @map("descricao")
  operador        String   @map("operador")
  dataHora        DateTime @default(now()) @map("data_hora")

  @@map("tb_defeitos_cftv")
}

// Auditorias e Sinalizações de Imagens CFTV
model AuditoriaImagem {
  id               String   @id @default(uuid())
  cameraNome       String   @map("camera_nome")
  timestampTrecho  DateTime @map("timestamp_trecho")
  descricaoFato    String   @map("descricao_fato")
  operador         String   @map("operador")
  tipo             String   @default("AUDITORIA") // AUDITORIA, SINALIZACAO_IMPORTANTE
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("tb_auditorias_imagens")
}

// Cautela e Controle de Extintores Reserva
model ControleExtintor {
  id                 String   @id @default(uuid())
  tipoMovimentacao   String   @map("tipo_movimentacao") // ENTREGA, RECEBIMENTO
  responsavelExterno String   @map("responsavel_externo")
  operadorCco        String   @map("operador_cco")
  motivo             String   @map("motivo")
  timestamp          DateTime @default(now()) @map("timestamp")

  @@map("tb_controle_extintores")
}

// Livro de Ocorrências e Eventos CCO
model Ocorrencia {
  id         String   @id @default(uuid())
  tipo       String   @default("GERAL") // GERAL, EVENTO
  nomeEvento String?  @map("nome_evento") // Preenchido apenas se tipo === EVENTO
  operador   String   @map("operador")
  detalhes   String   @map("detalhes")
  timestamp  DateTime @default(now()) @map("timestamp")

  @@map("tb_ocorrencias")
}
